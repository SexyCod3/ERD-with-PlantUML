@startuml rancangan

entity USER{
*id_user : INTEGER <<key>>
---
username : UNIQUE
email : UNIQUE
password_hash : VARCHAR
phone_number: VARCHAR
}

entity BUKU{
*id_buku : INTEGER <<key>>
---
id_pengunggah : INTEGER <<FK>>
---
judul: VARCHAR
tahun_terbit: YEAR
}

entity RAK_BUKU{
    *id_rak : INTEGER <<key>>
    ---
    id_user : INTEGER <<FK>>
    id_buku : INTEGER <<FK>>
    tanggal_mulai : DATE
    tanggal_kedaluwarsa: DATE
}


